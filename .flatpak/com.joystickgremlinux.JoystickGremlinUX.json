{
  "app-id": "com.joystickgremlinux.JoystickGremlinUX",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "JoystickGremlinUX",
  "separate-locales": false,
  "modules": [
    {
      "name": "python3-requirements",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=/app PyQt5 evdev reportlab"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://pythonhosted.org",
          "sha256": "4b68db60ec78e47bf4b143c7b7d7ca9df6a62ffcf595df874d6c75ef7a0fc6ea"
        },
        {
          "type": "file",
          "url": "https://pythonhosted.org",
          "sha256": "426f0fa0466be8515ce402be40f901170d47343e06cf057bb0810dbbf63f25c7"
        },
        {
          "type": "file",
          "url": "https://pythonhosted.org",
          "sha256": "82e4e11cb00bfbb0f69a19d08e70a312ba203597b819fbc7095039bebfd9c759"
        }
      ]
    },
    {
      "name": "app",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/JoystickGremlinUX",
        "cp -r * /app/share/JoystickGremlinUX/",
        "mkdir -p /app/bin",
        "echo '#!/bin/sh' > /app/bin/JoystickGremlinUX",
        "echo 'export PYTHONPATH=/app/lib/python3.11/site-packages:$PYTHONPATH' >> /app/bin/JoystickGremlinUX",
        "echo 'exec python3 /app/share/JoystickGremlinUX/joystick_gremlin.py \"$@\"' >> /app/bin/JoystickGremlinUX",
        "chmod +x /app/bin/JoystickGremlinUX"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ],
  "finish-args": [
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--device=all",
    "--filesystem=host:rw",
    "--filesystem=/dev/uinput:rw",
    "--talk-name=org.freedesktop.Flatpak"
  ]
}
