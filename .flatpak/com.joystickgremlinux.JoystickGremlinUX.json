{
  "app-id": "com.joystickgremlinux.JoystickGremlinUX",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "JoystickGremlinUX",
  "separate-locales": false,
  "modules": [
    {
      "name": "python3-requirements",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=/app PyQt5 evdev reportlab"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/0e/07/c9ed0bd428df6f87183fca565a79fee19fa7c88c7f00a7f011ab4379e77a/PyQt5-5.15.11.tar.gz",
          "sha256": "fda45743ebb4a27b4b1a51c6d8ef455c4c1b5d610c90d2934c7802b5c1557c52"
        },
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/a5/f5/397b61091120a9ca5001041dd7bf76c385b3bfd67a0e5bcb74b852bd22a4/evdev-1.9.3.tar.gz",
          "sha256": "2c140e01ac8437758fa23fe5c871397412461f42d421aa20241dc8fe8cfccbc9"
        },
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/4d/3f/b3861b7e40c9d66f4a04e018958d681d16b948bfd1963c962d43a8c23f66/reportlab-4.5.1.tar.gz",
          "sha256": "9fdf68f4de9171ec66acb4a5feed8f8ca2af43479e707a6fbb0daa75d88e5494"
        }
      ]
    },
    {
      "name": "app",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/JoystickGremlinUX",
        "cp -r * /app/share/JoystickGremlinUX/",
        "mkdir -p /app/bin",
        "echo '#!/bin/sh' > /app/bin/JoystickGremlinUX",
        "echo 'export PYTHONPATH=/app/lib/python3.11/site-packages:$PYTHONPATH' >> /app/bin/JoystickGremlinUX",
        "echo 'exec python3 /app/share/JoystickGremlinUX/joystick_gremlin.py \"$@\"' >> /app/bin/JoystickGremlinUX",
        "chmod +x /app/bin/JoystickGremlinUX"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ],
  "finish-args": [
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--device=all",
    "--filesystem=/dev/uinput:rw",
    "--talk-name=org.freedesktop.Flatpak"
  ]
}
